# Copy to .env.local. Nothing here is needed to run in mock mode.

# The media gateway key (treg.to). Without it the app runs in mock mode with sample files.
TREG_TOKEN=

# Force a mode: mock | live. Default: live when TREG_TOKEN is set, otherwise mock.
# TREG_MODE=mock

# Stop sending paid requests once this many US dollars were spent in 24 hours.
TREG_DAILY_BUDGET_USD=5

# Where the database and generated files live. Default: ./data
# PARALLAX_DATA_DIR=

# Set to 1 to fill a new install with demo content: four house accounts and about sixty
# published pictures (all made with Parallax, each with the prompt that made it).
# It is added once per data directory. Nobody can sign in as the demo accounts.
# PARALLAX_DEMO_SEED=1

# Set to off to close the demo top-up button.
# PARALLAX_DEMO_BILLING=off

# Set to 1 when serving over https, so the session cookie is marked Secure.
# COOKIE_SECURE=1

# Supercomputer (the agent chat). Without these it runs as a mock.
# SUPER_MODE=live
# ANTHROPIC_API_KEY=
# COMPOSIO_API_KEY=
# The computer the agent works on: a service you run yourself (see docs/computer-service.md).
# Default base is http://127.0.0.1:8081/api.
# COMPUTER_API_BASE_URL=
# COMPUTER_API_KEY=
# COMPUTER_WORKSPACE_ID=

# Run the Supercomputer chat on an Ariadne agent instead of the built-in loop.
# Read "Engines" in docs/api/super.md first. Keep the key and the token in files that only
# the server can read.
# SUPER_ENGINE=ariadne
# ARIADNE_URL=http://127.0.0.1:8642
# ARIADNE_API_KEY_FILE=/path/to/ariadne.key
# SUPER_ENGINE_TOKEN_FILE=/path/to/engine.token
# SUPER_ENGINE_NAME=Ariadne
# SUPER_TURN_MS=300000                # how long one turn may run (default 5 minutes, ceiling 30). A locally
#                                     # served model is slow: one step can take minutes, so a four-step turn
#                                     # passes five minutes and the chat ends with `time_limit`. Raise it for
#                                     # a lane on a local model: SUPER_TURN_MS=1800000
# ARIADNE_PER_CHAT=1                    # one `ariadne --serve` process per chat, because one serve holds one conversation
# ARIADNE_HOME=/absolute/path/to/home   # required with per-chat: each lane gets lanes/<chat-id>/ under it,
#                                       # with a config built from this home's config.yaml -- its tape and logs land there
# ARIADNE_BIN=ariadne                   # the binary lanes are started from
# ARIADNE_DISABLE_TOOLS=run_terminal,write_file,edit_file,list_dir,read_file

# Lane tuning. Not used while every chat dials one shared ARIADNE_URL.
# ARIADNE_PORT_BASE=8643                # first loopback port a lane binds; lane N takes the next free one
# ARIADNE_LANE_IDLE_MIN=20              # quiet minutes before a lane is closed
# ARIADNE_MAX_LANES=8                   # lanes open at once; the least recently used close first
# ARIADNE_MODEL=Ariadne                 # the name in the model pill
# ARIADNE_MCP_NAME=parallax             # the name of Parallax's entry in the agent's mcp_servers

# Running through deploy/start.sh? These are files under deploy/run/engine/ instead:
# engine.token, ariadne.key, name.txt, home.txt, bin.txt, port_base.txt, and an empty `off`
# to put the built-in engine back. See docs/using-parallax.md for the whole layout.
